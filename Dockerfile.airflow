FROM apache/airflow:2.9.0-python3.11

USER root

# Instalar OpenJDK 17 headless para soporte de spark-submit
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless \
        procps \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

USER airflow

# Instalar providers y librerias necesarias sin back-tracking de pip
RUN pip install --no-cache-dir \
    dbt-core==1.8.2 \
    dbt-postgres==1.8.2 \
    apache-airflow-providers-apache-spark==4.8.0 \
    apache-airflow-providers-apache-kafka==1.4.0 \
    pyspark==3.5.1 \
    delta-spark==3.1.0 \
    confluent-kafka \
    boto3 \
    pandas \
    requests
